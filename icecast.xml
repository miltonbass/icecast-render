<?xml version="1.0"?>
<icecast>
    <location>Render Cloud</location>
    <admin>radio@render.com</admin>
    
    <limits>
        <clients>100</clients>
        <sources>5</sources>
        <threadpool>5</threadpool>
    </limits>
    
    <authentication>
        <source-password>render_source_123</source-password>
        <relay-password>render_relay_123</relay-password>
        <admin-user>admin</admin-user>
        <admin-password>render_admin_123</admin-password>
    </authentication>
    
    <hostname>0.0.0.0</hostname>
    <listen-socket>
        <port>8000</port>  <!-- Será reemplazado por el script -->
    </listen-socket>
    
    <paths>
        <logdir>/var/log/icecast2</logdir>
        <webroot>/usr/share/icecast2/web</webroot>
        <adminroot>/usr/share/icecast2/web</adminroot>
    </paths>
    
    <logging>
        <accesslog>access.log</accesslog>
        <errorlog>error.log</errorlog>
        <loglevel>2</loglevel>
    </logging>
    
    <security>
        <chroot>0</chroot>
        <changeowner>
            <user>icecastuser</user>
            <group>icecastuser</group>
        </changeowner>
    </security>
</icecast>